# Paired STAR project repo (optional — leave empty when writing without one)
STAR_HOME=

# Build engine: pdflatex | xelatex | lualatex
LATEX_ENGINE=pdflatex

# Submission anonymity mode: when true, execs/scpts/lint.sh hunts identity leaks
ANON=false

# Upstream STAGE repo used by execs/update.sh
STAGE_REPOSITORY=https://github.com/wanghao9610/STAGE.git

# Optional. Harness trees execs/update.sh installs and keeps current, comma
# separated: claude, codex, cursor, dsh, kimi, pi, qwen — or all (default), or
# none for the shared skeleton only. --harnesses overrides this for one run.
STAGE_HARNESSES=

# Optional. How much the STAGE skills ask before deciding (workflow conventions
# §7.7): low = take the recommended option on judgment calls and log it, commit
# without asking and name each commit in the reply (§1.6), and in Claude Code,
# Codex, and Qwen Code skip the permission prompt before each file edit (in
# Claude Code, before a shell command too, unless it deletes, overwrites a
# tracked file, installs, pushes, or writes to mates/, a venue kit, or .env);
# medium = ask as documented (default); high = confirm item by item. No level
# revokes an approval you already gave or grants one you did not, and what you
# already approved is not asked again within its scope. Hard gates — the STOP
# line, deletions, overwrites, venue values entering as confirmed, evidence
# provenance, the slash-only skills' decision points — are asked at every level.
# No level starts the next run a reply names: a read-only request never starts a
# writing skill, and continuing is /stage-auto's job (§11.4).
INVOLVE=medium

# Optional. Language for chat replies and the Markdown the workflow writes —
# notes/, tasks/, wkdrs/ reports (workflow conventions §7.6):
# en or zh. Unset or empty = follow the conversation's language; an explicit
# in-conversation request overrides it. Always English whatever this says: the
# manuscript under manus/ and the response to reviewers. Existing documents keep
# the language they were written in — STAGE_LANG never rewrites them.
STAGE_LANG=

# Optional. Model for each STAGE tier (workflow conventions §11.6). PLAN = the
# story, the outline, drafting, the simulated review, the response; EXEC =
# evidence, tables, figures, references, polish, the audits, packing, the poster;
# READ = read-only status, the check modes, and collector delegates. A skill you
# type stays on the session's model and says in one line when its tier names
# another. Only a harness whose dispatch tool takes a model per call reads these —
# Claude Code, and Codex where its subagent interface accepts one; Cursor, DSH,
# Kimi Code, Pi, and Qwen Code ignore them. Empty = nothing changes.
#
# One model name, or comma-separated <harness>:<model> (tags from
# STAGE_HARNESSES). A run takes its tree's entry, else an untagged one, else
# empty. Unavailable model: keep the working route and report it.
#
# Example: STAGE_PLAN_MODEL=fable, STAGE_EXEC_MODEL=opus, STAGE_READ_MODEL=sonnet
# Per tree: claude:fable,codex:gpt-6-astra
STAGE_PLAN_MODEL=
STAGE_EXEC_MODEL=
STAGE_READ_MODEL=
