# Builds and ephemeral reports are regenerable; keep the Markdown reports
# indexable so the audits and the status skill can still read them.
wkdrs/**
!wkdrs/**/
!wkdrs/**/*.md

# Editor-side LaTeX build output beside the sources (run.sh builds out-of-tree).
manus/out/
.texpadtmp/
.vscode/ltex*

