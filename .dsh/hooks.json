{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".dsh/hooks/stage_model_id.sh"
          },
          {
            "type": "command",
            "command": ".dsh/hooks/stage_memory.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "bash",
        "hooks": [
          {
            "type": "command",
            "command": ".dsh/hooks/stage_commit_guard.sh"
          }
        ]
      }
    ]
  }
}
