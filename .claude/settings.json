{
  "permissions": {
    "allow": [
      "Bash(bash .claude/hooks/stage_model_id.sh --resolve:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stage_involve_gate.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stage_commit_guard.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stage_model_id.sh",
            "statusMessage": "Recording session model id for STAGE provenance"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stage_memory.sh",
            "statusMessage": "Loading STAGE project memory"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stage_model_id.sh --subagent",
            "statusMessage": "Handing the delegate its STAGE provenance command"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stage_memory.sh --subagent",
            "statusMessage": "Loading STAGE project memory for the delegate"
          }
        ]
      }
    ]
  }
}
